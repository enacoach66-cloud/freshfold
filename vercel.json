{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/orders", "destination": "/orders/index.html" },
    { "source": "/orders/login", "destination": "/orders/login.html" }
  ],
  "headers": [
    {
      "source": "/orders/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "same-origin" }
      ]
    }
  ]
}
